# Environment variables for the Supply Chain Disruption Assistant

# Copy this file to .env and replace the placeholder values with real credentials.

# Never commit .env to Git.

# IBM watsonx.ai

# These variables are optional. The dashboard works without them.

WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
